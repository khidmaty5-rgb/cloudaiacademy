# MinIO / S3-compatible settings (server-only)
# Example for local MinIO at http://127.0.0.1:9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_JOURNAL=cloudai-journal-pdfs
S3_BUCKET_LESSONS=cloudai-lesson-pdfs
S3_BUCKET_CERTIFICATES=cloudai-certificates

# Create this bucket in MinIO for acceptance test
# cloudai-journal-pdfs
# cloudai-lesson-pdfs
# cloudai-certificates

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (server-only)
# PAYPAL_ENV can be "sandbox" or "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
