# Example environment variables
# Copy to .env.local and fill with real values

# Firebase Admin (server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (server)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (server)
# PAYPAL_ENV can be "sandbox" or "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# WhatsApp/Telegram n8n webhook secret
N8N_WEBHOOK_SECRET=changeme
