/**
 * @file Overview
 * This ruleset enforces a user-ownership model for user profiles, enrollments, and learning paths.
 * It assumes courses are globally accessible.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the authenticated user can access their own profile.
 * - /courses/{courseId}: Stores course information. Assumed to be globally accessible.
 * - /users/{userId}/enrollments/{enrollmentId}: Stores enrollment records. Only the user can access their own enrollments.
 * - /users/{userId}/learningPaths/{learningPathId}: Stores learning paths. Only the user can access their own learning paths.
 * - /announcements/{announcementId}: Stores announcements. Assumed to be publicly accessible.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Courses are globally readable. Write access to courses is not defined in the IR and is therefore denied.
 * - Read access to announcements is public. Write access to announcements is not defined in the IR and is therefore denied.
 *
 * To improve security and performance, data required for authorization (like ownership) is denormalized directly
 * onto the secured documents. This avoids costly `get()` calls in the rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the authenticated user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner and the resource exists.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the authenticated user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Role helpers. Prefer the user's profile doc role, and fall back to token claims.
    // This prevents stale/missing claims from breaking core flows (enrollment/paywall gating).
    function profileRole() {
      return (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : null
      );
    }

    function requesterRole() {
      // If the profile role exists, treat it as authoritative; claims can be stale.
      return profileRole() != null ? profileRole() : request.auth.token.role;
    }

    function roleIsStaff(role) {
      return role == 'admin' || role == 'teacher' || role == 'reviewer' || role == 'editor';
    }

    function roleIsAdminOrEditor(role) {
      return role == 'admin' || role == 'editor';
    }

    function isAdmin() {
      return isSignedIn() && requesterRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && requesterRole() == 'teacher';
    }

    function isStudent() {
      // Students are the "default" role: anything that is not staff is treated as a student.
      return isSignedIn() && !roleIsStaff(requesterRole());
    }

    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    function isEditor() {
      return isSignedIn() && roleIsAdminOrEditor(requesterRole());
    }

    // Helper to determine if the requester is an instructor of a given course
    function isInstructorOfCourse(courseId) {
      return (
        isAdmin() || (
          isTeacher() &&
          exists(/databases/$(database)/documents/courses/$(courseId)) &&
          (
            get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid ||
            (
              (get(/databases/$(database)/documents/courses/$(courseId)).data.instructorIds is list) &&
              request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.instructorIds
            )
          )
        )
      );
    }

    function priceIsFree(price) {
      return (
        ((price is string) && price.matches('^\\s*(Free|free|FREE|\\$0|0|0\\.00)\\s*$')) ||
        ((price is number) && price <= 0)
      );
    }

    // Paywall settings live in /settings/payment (public read; admin write).
    function paywallEnabled() {
      return (
        exists(/databases/$(database)/documents/settings/payment) &&
        (get(/databases/$(database)/documents/settings/payment).data.paywall is map) &&
        (get(/databases/$(database)/documents/settings/payment).data.paywall.enabled == true)
      );
    }

    // Treat courses with price == 'Free' as not requiring payment, even if paywall is enabled.
    function courseIsFree(courseId) {
      return (
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        priceIsFree(get(/databases/$(database)/documents/courses/$(courseId)).data.price)
      );
    }

    function defaultRequirePayment() {
      return (
        paywallEnabled() &&
        (get(/databases/$(database)/documents/settings/payment).data.paywall.defaultRequirePayment == true)
      );
    }

    function coursePurchased(courseId) {
      return (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/coursePurchases/$(courseId))
      );
    }

    // Deny access if payment is required (students only).
    function accountActive() {
      return isSignedIn() && (
        // Staff always pass (based on token claims)
        roleIsStaff(requesterRole()) ||
        // If the payment settings doc does not exist, treat paywall as OFF.
        !exists(/databases/$(database)/documents/settings/payment) ||
        // Paywall OFF => allow.
        get(/databases/$(database)/documents/settings/payment).data.paywall.enabled != true ||
        // Paywall ON: enforce student payment flags.
        (
          get(/databases/$(database)/documents/settings/payment).data.paywall.defaultRequirePayment == true
            ? (
              // Default requires payment: only explicit requirePayment=false is active.
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.requirePayment == false
            )
            : (
              // Default does not require payment: only explicit requirePayment=true blocks.
              !(
                exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.requirePayment == true
              )
            )
        )
      );
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @allow (get, update, delete) Authenticated user can access and modify their own profile.
     * @deny (create, update, delete) Any other user cannot access or modify another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Owners can read their own doc; admins can read any
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list users
      allow list: if isAdmin();
      // Owners create their own profile with strict constraints
      allow create: if (
        isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'student' &&
        (
          defaultRequirePayment()
            // When paywall is ON + default requires payment, prevent users from bypassing
            // by self-setting requirePayment=false during create.
            ? request.resource.data.requirePayment != false
            // Otherwise, do not allow users to create themselves with requirePayment=true.
            : request.resource.data.requirePayment != true
        )
      );
      // Owners can update their profile only if sensitive fields are unchanged; admins can update any
      allow update: if (
        (
          isExistingOwner(userId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.requirePayment == resource.data.requirePayment &&
          request.resource.data.dateJoined == resource.data.dateJoined
        ) || isAdmin()
      );
      // Owners can delete themselves; admins can delete any user
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for courses.
     * @path /courses/{courseId}
     * @allow (get, list) Any user can read courses.
     * @allow (create, update, delete) Admins can manage courses.
     * @allow (create, update, delete on lessons) Admins and assigned teachers can manage lessons.
     * @principle Allows public read access with restricted writes.
     */
    match /courses/{courseId} {
      // Public can only see published courses; staff and enrolled users can see their courses.
      allow get, list: if (
        isInstructorOfCourse(courseId) ||
        (resource.data.status != 'DRAFT') ||
        (accountActive() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId)))
      );
      // Admins can create/update/delete courses. Teachers cannot update course metadata.
      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      // Lessons subcollection access
      match /lessons/{lessonId} {
        // Read if admin/assigned instructor, or the user is enrolled AND account is active (no payment required)
        allow get, list: if isInstructorOfCourse(courseId) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId)) &&
          (courseIsFree(courseId) || coursePurchased(courseId) || accountActive())
        );

        // Only admins or assigned instructors can create/update/delete lessons
        allow create, update, delete: if isInstructorOfCourse(courseId);
      }
    }

    /**
     * @description Rules for enrollments.
     * @path /users/{userId}/enrollments/{enrollmentId}
     * @allow (create, get, list, update, delete) Authenticated user can manage their own enrollments.
     * @deny (create, get, list, update, delete) Any other user cannot access or modify another user's enrollments.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/enrollments/{enrollmentId} {
      // Owners, admins, or instructors of the course can read enrollments
      allow get: if isOwner(userId) || isAdmin() || isInstructorOfCourse(enrollmentId);
      allow list: if isOwner(userId) || isAdmin() || isInstructorOfCourse(enrollmentId);
      // Students can enroll directly when the course is open; when full, they must be approved via waitlist.
      allow create: if (
        isOwner(userId) &&
        // Enrolling users must be students (based on claims + profile fallback).
        exists(/databases/$(database)/documents/users/$(userId)) &&
        isStudent() &&
        request.resource.data.userId == userId &&
        request.resource.data.courseId == enrollmentId &&
        // Course open => direct enrollment allowed. Course full => must be approved first.
        (
          exists(/databases/$(database)/documents/courses/$(enrollmentId)) &&
          (
            get(/databases/$(database)/documents/courses/$(enrollmentId)).data.isFull != true ||
            get(/databases/$(database)/documents/users/$(userId)/enrollmentRequests/$(enrollmentId)).data.status == 'APPROVED'
          )
        )
      );
      allow update: if (
        isExistingOwner(userId) &&
        request.resource.data.userId == resource.data.userId &&
        (courseIsFree(enrollmentId) || coursePurchased(enrollmentId) || accountActive())
      );
      // Admins can unenroll students.
      allow delete: if isAdmin() || isExistingOwner(userId);
    }

    match /users/{userId}/coursePurchases/{courseId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{path=**}/enrollments/{enrollmentId} {
      allow get, list: if isAdmin() || isInstructorOfCourse(enrollmentId) || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    // Collection group support for enrollmentRequests (waitlist) queries.
    match /{path=**}/enrollmentRequests/{requestId} {
      allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    /**
     * @description Enrollment requests (waitlist).
     * @path /users/{userId}/enrollmentRequests/{courseId}
     * @allow Students can create/delete their own requests; admins/teachers can view and update status.
     */
    match /users/{userId}/enrollmentRequests/{courseId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if (
        isOwner(userId) &&
        isStudent() &&
        request.resource.data.userId == userId &&
        request.resource.data.courseId == courseId &&
        request.resource.data.status == 'PENDING' &&
        // Only allow waitlist requests when the course is marked full.
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.isFull == true
      );
      allow update: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for learning paths.
     * @path /users/{userId}/learningPaths/{learningPathId}
     * @allow (create, get, list, update, delete) Authenticated user can manage their own learning paths.
     * @deny (create, get, list, update, delete) Any other user cannot access or modify another user's learning paths.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/learningPaths/{learningPathId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for certificates.
     * @path /certificates/{certificateId} and /users/{userId}/certificates/{certificateId}
     * @allow (get) Anyone can verify a certificate by ID.
     * @allow (list) Disallowed on top-level certificates to prevent enumeration.
     * @allow (create, update, delete) Admins can manage certificates.
     * @principle Public verification + controlled issuance.
     */
    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/certificates/{certificateId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list) Any user can read announcements.
     * @allow (create, update, delete) Admins and Teachers can manage announcements.
     * @principle Allows public read access with restricted writes.
     */
    match /announcements/{announcementId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }

    // Journal visibility flag stored in /settings/ui.showJournalNav (default: enabled).
    function journalEnabled() {
      return exists(/databases/$(database)/documents/settings/ui)
        ? get(/databases/$(database)/documents/settings/ui).data.showJournalNav != false
        : true;
    }

    match /settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /journalArticles/{articleId} {
      // Create: signed-in author can create their own submission
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.title is string)
        && (request.resource.data.abstract is string)
        && (request.resource.data.authors is string)
        && (request.resource.data.language in ['en', 'ar'])
        && (request.resource.data.pdfPath is string)
        && request.resource.data.pdfPath.matches('^journal/articles/' + request.auth.uid + '/.+\\.pdf$')
        // Prevent users from self-publishing or assigning issues via client writes.
        && (request.resource.data.status == 'SUBMITTED')
        && (request.resource.data.issueId == null)
        && (request.resource.data.acceptedAt == null)
        && (request.resource.data.publishedAt == null);

      // Read: public can read PUBLISHED; author can read own; editors/admins can read all
      allow read: if (
        isEditor()
        || isAdminOrTeacher()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid)
        || (journalEnabled() && resource != null && resource.data.status == 'PUBLISHED')
      );

      // Update rules
      // Editors/admins can update anything
      allow update, delete: if isEditor()
        || (
          // Authors may update their own while in DRAFT or SUBMITTED (metadata only)
          isSignedIn() && resource.data.createdBy == request.auth.uid
          && (resource.data.status in ['DRAFT', 'SUBMITTED'])
          // Authors cannot change status in rules (editor moves it forward)
          && (request.resource.data.status == resource.data.status)
          // After UNDER_REVIEW, only editors can modify (enforced by first condition)
        );
    }

    match /journalIssues/{issueId} {
      allow get, list: if journalEnabled() || isEditor() || isAdminOrTeacher();
      allow create, update, delete: if isEditor();
    }
  }
}
